{
  "name": "kumwe/approval",
  "description": "Portable maker-checker approval bindings, state transitions, query ports and transaction-bound services.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/approval",
  "require": {
    "php": "^8.5",
    "ext-mbstring": "*",
    "kumwe/access-context": "0.1.0",
    "kumwe/access-control": "0.1.0",
    "kumwe/audit": "0.1.0",
    "kumwe/transaction": "0.1.0",
    "psr/clock": "^1.0",
    "psr/container": "^2.0",
    "ramsey/uuid": "^4.9"
  },
  "require-dev": {
    "laminas/laminas-servicemanager": "^4.0",
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {"psr-4": {"Kumwe\\Approval\\": "src/"}},
  "autoload-dev": {"psr-4": {"Kumwe\\Approval\\Tests\\": "tests/"}},
  "config": {"sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
